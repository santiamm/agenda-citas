# Supabase → Project Settings → API. La clave "publishable" es pública (va en el navegador);
# la seguridad la ponen las reglas RLS de la base de datos. Nunca pongas aquí la "secret key".
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Avisos y bot: secreto del servidor (su huella SHA-256 va en private.app_config, ver README).
APP_SECRET=
# Notificaciones push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Correo al dueño (opcional): Gmail con contraseña de aplicación, Brevo, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# WhatsApp oficial de Meta (opcional). Webhook: /api/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
